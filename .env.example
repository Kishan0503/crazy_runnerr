# Supabase — copy this file to `.env.local` and fill in your project's values.
# Find both in the Supabase dashboard: Project Settings → API.
#
# The ANON key is PUBLIC and safe to ship in the browser bundle — Row-Level
# Security (not key secrecy) is what protects data. Never put the service_role
# key here or anywhere in client code; it belongs only in server/edge functions.
#
# Vite only exposes vars prefixed with VITE_ to the client.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
